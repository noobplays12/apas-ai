{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a student, teacher, or admin in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "rollNo": { "type": "string", "description": "Only for students" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "classId": { "type": "string", "description": "Reference to Class entity" },
        "deviceId": { "type": "string", "description": "Fingerprint of the registered device" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Class": {
      "title": "Class",
      "description": "Represents a university class/section.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "section": { "type": "string" }
      },
      "required": ["name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Represents a course subject.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["name"]
    },
    "Session": {
      "title": "Session",
      "description": "An active attendance session created by a teacher.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "teacherId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "radius": { "type": "number", "description": "Geofence radius in meters" }
          }
        },
        "wifiSSID": { "type": "string" },
        "isActive": { "type": "boolean" },
        "verifyGPS": { "type": "boolean" },
        "verifyWiFi": { "type": "boolean" }
      },
      "required": ["classId", "subjectId", "teacherId", "startTime", "endTime", "isActive"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "A record of a student's attendance for a session.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "sessionId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["present", "absent"] },
        "deviceId": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        },
        "wifiSSID": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "required": ["studentId", "sessionId", "timestamp", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Class definitions"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Subject definitions"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Active and past attendance sessions"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Attendance records"
    }
  }
}
